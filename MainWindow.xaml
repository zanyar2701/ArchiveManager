<Window x:Class="ArchiveManager.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ArchiveManager.UI.ViewModels"
        xmlns:conv="clr-namespace:ArchiveManager.UI.Converters"
        x:Name="RootWindow"
        Title="Archive Manager" Height="768" Width="1360" MinHeight="650" MinWidth="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:FileTypeToColorConverter x:Key="FileTypeToColorConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:NullToBoolConverter x:Key="NullToBoolConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />   <!-- Top nav -->
            <RowDefinition Height="*" />    <!-- Body -->
            <RowDefinition Height="32" />   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ===================== TOP NAVIGATION ===================== -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="20" Margin="0,0,8,0" />
                    <TextBlock Text="Archive Manager" Style="{StaticResource PanelHeaderStyle}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBox Grid.Column="1" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Style="{StaticResource SearchBoxStyle}"
                         Tag="جستجوی سریع..."
                         Text="{Binding Search.QueryText, UpdateSourceTrigger=PropertyChanged}"
                         GotFocus="QuickSearch_GotFocus" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="خانه" Command="{Binding GoHomeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0" />
                    <Button Content="بایگانی" Command="{Binding GoToArchiveCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0" />
                    <Button Content="گزارش‌ها" Command="{Binding GoToReportsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0" />
                    <Button Content="راهنما" Command="{Binding GoToGuideCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0" />
                    <Button Content="تنظیمات" Command="{Binding GoToSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0" />
                    <TextBlock Text="FA | EN" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== BODY ===================== -->
        <Grid Grid.Row="1">

            <!-- == Archive tab == -->
            <Grid Visibility="{Binding ActiveTab, Converter={x:Static conv:EnumToVisibility.Instance}, ConverterParameter=Archive}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: Archive tree -->
                <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
                    <TreeView x:Name="ArchiveTreeView" Background="Transparent" BorderThickness="0" Margin="8"
                              ItemsSource="{Binding Tree.RootNodes}"
                              SelectedItemChanged="ArchiveTreeView_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2" Tag="{Binding}">
                                    <TextBlock Text="📁" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock Text="{Binding ArchiveCode}" Style="{StaticResource CaptionTextStyle}" Margin="6,0,0,0"
                                               Visibility="{Binding IsCompany, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <!--
                                      Context menu actions for a company/person node (entity-identity
                                      addendum "USER INTERFACE" list). CommandParameter/Command are
                                      bound via PlacementTarget.Tag and the root Window's DataContext
                                      because a WPF ContextMenu is a separate visual-tree root and does
                                      not inherit DataContext from its placement target.
                                    -->
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="باز کردن پوشه"
                                                      Command="{Binding DataContext.OpenEntityFolderCommand, ElementName=RootWindow}"
                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="ثبت سند"
                                                      Command="{Binding DataContext.RegisterDocumentForEntityCommand, ElementName=RootWindow}"
                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="تغییر نام"
                                                      Command="{Binding DataContext.RenameEntityCommand, ElementName=RootWindow}"
                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="تغییر مرحله / انتقال پرونده"
                                                      Command="{Binding DataContext.TransferEntityCommand, ElementName=RootWindow}"
                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="تاریخچه پرونده"
                                                      Command="{Binding DataContext.ShowEntityHistoryCommand, ElementName=RootWindow}"
                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="مشاهده اطلاعات"
                                                      Command="{Binding DataContext.ShowEntityInfoCommand, ElementName=RootWindow}"
                                                      CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Border>

                <!-- CENTER: File browser -->
                <Grid Grid.Column="1" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Browser.CurrentFolderTitle}" Style="{StaticResource PageTitleStyle}" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12">
                        <Button Content="＋ ثبت سند جدید" Command="{Binding Browser.RegisterNewDocumentCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                        <Button Content="بازخوانی" Command="{Binding Browser.RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>

                    <TextBox Grid.Row="2" Width="280" HorizontalAlignment="Left" Margin="0,0,0,12"
                             Style="{StaticResource SearchBoxStyle}" Tag="جستجو در بایگانی..."
                             Text="{Binding Browser.LocalFilterText, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Grid.Row="3">
                        <TextBlock Text="این پوشه خالی است" Style="{StaticResource CaptionTextStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Browser.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <DataGrid ItemsSource="{Binding Browser.Files}" SelectedItem="{Binding Browser.SelectedFile}"
                                  AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource SurfaceBrush}"
                                  BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" RowHeight="36"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  Visibility="{Binding Browser.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            <DataGrid.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding Browser.OpenSelectedFileCommand}" />
                            </DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="32">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="10" Height="10" Fill="{Binding IconKey, Converter={StaticResource FileTypeToColorConverter}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="نام فایل" Binding="{Binding FileName}" Width="*" />
                                <DataGridTextColumn Header="نوع" Binding="{Binding TypeLabel}" Width="80" />
                                <DataGridTextColumn Header="سال" Binding="{Binding YearDisplay}" Width="70" />
                                <DataGridTextColumn Header="حجم" Binding="{Binding SizeDisplay}" Width="80" />
                                <DataGridTextColumn Header="تاریخ ثبت" Binding="{Binding RegisteredAtDisplay}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <!-- RIGHT: Document registration panel -->
                <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1,0,0,0">
                    <ScrollViewer Margin="16">
                        <StackPanel>
                            <TextBlock Text="ثبت و نام‌گذاری سند" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,16" />

                            <Button Content="{Binding Registration.SourceFileDisplay}" Command="{Binding Registration.PickFileCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Center" Margin="0,0,0,16" />

                            <TextBlock Text="نوع سند:" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding Registration.DocumentTypes}" Text="{Binding Registration.DocumentType, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" Style="{StaticResource FormInputStyle}" Margin="0,0,0,12" />

                            <TextBlock Text="موضوع:" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding Registration.Subjects}" Text="{Binding Registration.Subject, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" Style="{StaticResource FormInputStyle}" Margin="0,0,0,12" />

                            <TextBlock Text="سال:" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Registration.Year, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputStyle}" Margin="0,0,0,12" />

                            <TextBlock Text="نسخه (اختیاری):" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Registration.VersionText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputStyle}" Margin="0,0,0,12" />

                            <TextBlock Text="نام شرکت:" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding Registration.CompanyName}" IsReadOnly="True" Style="{StaticResource FormInputStyle}" Margin="0,0,0,12" />

                            <TextBlock Text="فرمت فایل:" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox ItemsSource="{Binding Registration.Formats}" SelectedItem="{Binding Registration.FileFormat}"
                                      Style="{StaticResource FormInputStyle}" Margin="0,0,0,16" />

                            <TextBlock Text="نام فایل نهایی:" Style="{StaticResource FieldLabelStyle}" />
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                    CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Registration.FilenamePreview}" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
                            </Border>

                            <TextBlock Text="{Binding Registration.ValidationMessage}" Foreground="{StaticResource ErrorBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding Registration.ValidationMessage, Converter={x:Static conv:StringToVisibility.Instance}}" />

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="تغییر نام فایل" Command="{Binding Registration.RenameFileCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="2" Content="کپی نام" Command="{Binding Registration.CopyNameCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>

                            <Button Content="ثبت در بایگانی" Command="{Binding Registration.RegisterCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- == Reports tab == -->
            <ScrollViewer Visibility="{Binding ActiveTab, Converter={x:Static conv:EnumToVisibility.Instance}, ConverterParameter=Reports}" Margin="24">
                <StackPanel>
                    <TextBlock Text="گزارش‌ها و آمار بایگانی" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,16" />
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="تعداد شرکت‌ها" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding Statistics.Stats.CompanyCount}" Style="{StaticResource PageTitleStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="تعداد اسناد" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding Statistics.Stats.DocumentCount}" Style="{StaticResource PageTitleStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="فایل‌های مفقود" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding Statistics.Stats.MissingFileCount}" Style="{StaticResource PageTitleStyle}" />
                            </StackPanel>
                        </Border>
                        <Button Content="بازخوانی آمار" Command="{Binding Statistics.RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" />
                    </UniformGrid>

                    <TextBlock Text="اسناد بر اساس نوع سند" Style="{StaticResource PanelHeaderStyle}" Margin="0,8,0,8" />
                    <ItemsControl ItemsSource="{Binding Statistics.Stats.ByDocumentType}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" />
                                    <Border Grid.Column="1" Background="{StaticResource AccentBrush}" Height="16" HorizontalAlignment="Left"
                                            Width="{Binding Count, Converter={x:Static conv:CountToBarWidth.Instance}}" CornerRadius="4" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="اسناد بر اساس شرکت" Style="{StaticResource PanelHeaderStyle}" Margin="0,16,0,8" />
                    <ItemsControl ItemsSource="{Binding Statistics.Stats.ByCompany}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyTextStyle}">
                                    <Run Text="{Binding Name}" /> — <Run Text="{Binding Count}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Entity-identity summary counts (addendum "REPORTING") -->
                    <TextBlock Text="پرونده‌ها بر اساس مرحله" Style="{StaticResource PanelHeaderStyle}" Margin="0,16,0,8" />
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="افراد در پیش‌رشد" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding Statistics.Stats.PeopleInPreGrowthCount}" Style="{StaticResource PanelHeaderStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="شرکت‌ها در رشد" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding Statistics.Stats.CompaniesInGrowthCount}" Style="{StaticResource PanelHeaderStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="شرکت‌ها در پارکی" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding Statistics.Stats.CompaniesInParkCount}" Style="{StaticResource PanelHeaderStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="خروج‌یافته" Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{Binding Statistics.Stats.ExitedEntitiesCount}" Style="{StaticResource PanelHeaderStyle}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- COMPANY LIST table (addendum) -->
                    <TextBlock Text="فهرست پرونده‌ها" Style="{StaticResource PanelHeaderStyle}" Margin="0,8,0,8" />
                    <DataGrid ItemsSource="{Binding Statistics.Entities}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" MaxHeight="300" Margin="0,0,0,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کد پرونده" Binding="{Binding ArchiveCode}" Width="80" />
                            <DataGridTextColumn Header="نام فعلی" Binding="{Binding CurrentName}" Width="*" />
                            <DataGridTextColumn Header="نوع" Binding="{Binding EntityTypeDisplay}" Width="60" />
                            <DataGridTextColumn Header="مرحله" Binding="{Binding StageName}" Width="120" />
                            <DataGridTextColumn Header="نام قبلی" Binding="{Binding PreviousName}" Width="140" />
                            <DataGridTextColumn Header="تاریخ ورود" Binding="{Binding EnteredAt, StringFormat='yyyy/MM/dd'}" Width="90" />
                            <DataGridTextColumn Header="آخرین تغییر" Binding="{Binding LastUpdatedAt, StringFormat='yyyy/MM/dd'}" Width="90" />
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusDisplay}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Recent transfers / name changes / Person→Company transitions -->
                    <TextBlock Text="انتقال‌های اخیر" Style="{StaticResource PanelHeaderStyle}" Margin="0,8,0,8" />
                    <ItemsControl ItemsSource="{Binding Statistics.Stats.RecentTransfers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyTextStyle}">
                                    <Run Text="{Binding EntityName}" FontWeight="SemiBold" /> — <Run Text="{Binding Description}" />
                                    (<Run Text="{Binding Date, StringFormat='yyyy/MM/dd'}" />)
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="تبدیل‌های شخص به شرکت" Style="{StaticResource PanelHeaderStyle}" Margin="0,16,0,8" />
                    <ItemsControl ItemsSource="{Binding Statistics.Stats.PersonToCompanyTransitions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyTextStyle}">
                                    <Run Text="{Binding EntityName}" FontWeight="SemiBold" /> — <Run Text="{Binding Description}" />
                                    (<Run Text="{Binding Date, StringFormat='yyyy/MM/dd'}" />)
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- == Settings tab == -->
            <StackPanel Visibility="{Binding ActiveTab, Converter={x:Static conv:EnumToVisibility.Instance}, ConverterParameter=Settings}" Margin="24" MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Text="تنظیمات" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,16" />

                <TextBlock Text="مسیر ریشه بایگانی:" Style="{StaticResource FieldLabelStyle}" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Settings.ArchiveRootPath}" Style="{StaticResource FormInputStyle}" />
                    <Button Grid.Column="2" Content="انتخاب پوشه..." Command="{Binding Settings.BrowseArchiveRootCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>

                <TextBlock Text="زبان (Language):" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox SelectedValue="{Binding Settings.Language}" SelectedValuePath="Tag" Style="{StaticResource FormInputStyle}" Margin="0,0,0,16">
                    <ComboBoxItem Content="فارسی" Tag="fa" />
                    <ComboBoxItem Content="English" Tag="en" />
                </ComboBox>

                <CheckBox Content="استفاده از اعداد فارسی" IsChecked="{Binding Settings.UsePersianDigits}" Margin="0,0,0,16" />

                <Button Content="ذخیره تنظیمات" Command="{Binding Settings.SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,24" />

                <Separator Margin="0,0,0,16" />
                <TextBlock Text="پشتیبان‌گیری و بازیابی" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="پشتیبان‌گیری از پایگاه داده" Command="{Binding Settings.CreateBackupCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="بازیابی پایگاه داده" Command="{Binding Settings.RestoreBackupCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- == Guide tab == -->
            <ScrollViewer Visibility="{Binding ActiveTab, Converter={x:Static conv:EnumToVisibility.Instance}, ConverterParameter=Guide}" Margin="24">
                <TextBlock Text="{Binding Guide.GuideMarkdown}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left" />
            </ScrollViewer>

            <!-- == Search overlay == -->
            <Border Background="#CC000000" Visibility="{Binding IsSearchOverlayOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="{StaticResource SurfaceBrush}" Width="600" MaxHeight="500" VerticalAlignment="Top" Margin="0,80,0,0"
                        CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="نتایج جستجو" Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Search.Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" Style="{StaticResource BodyTextStyle}" />
                                            <TextBlock Text="{Binding CompanyName}" Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="نتیجه‌ای یافت نشد" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,16"
                                   Visibility="{Binding Search.HasResults, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                        <Button Content="بستن" Command="{Binding ToggleSearchOverlayCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- == Duplicate resolution dialog == -->
            <Border Background="#CC000000" Visibility="{Binding IsDuplicateDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="{StaticResource SurfaceBrush}" Width="420" Height="Auto" VerticalAlignment="Center" HorizontalAlignment="Center"
                        CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="این فایل قبلاً وجود دارد." Style="{StaticResource PanelHeaderStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding PendingDuplicateFileName}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <Button Content="ایجاد نسخه جدید" Command="{Binding ResolveDuplicateWithVersionCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" />
                        <Button Content="لغو" Command="{Binding CancelDuplicateCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Border>
            </Border>

        </Grid>

        <!-- ===================== STATUS BAR ===================== -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock Text="{Binding DocumentCountDisplay}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusBreadcrumb}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</Window>
