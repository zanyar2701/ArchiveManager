<Window x:Class="ArchiveManager.UI.Views.Dialogs.EntityRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغییر نام" Height="360" Width="420" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="تغییر نام پرونده" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,16" />

        <TextBlock Text="نام فعلی:" Style="{StaticResource FieldLabelStyle}" />
        <TextBlock Text="{Binding CurrentName}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,12" />

        <TextBlock Text="نام جدید:" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputStyle}" Margin="0,0,0,12" />

        <TextBlock Text="علت / توضیحات (اختیاری):" Style="{StaticResource FieldLabelStyle}" />
        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormInputStyle}"
                 AcceptsReturn="True" Height="50" TextWrapping="Wrap" Margin="0,0,0,12" />

        <CheckBox Content="تغییر نام پوشه فیزیکی نیز انجام شود" IsChecked="{Binding RenamePhysicalFolder}" Margin="0,0,0,12" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="لغو" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Grid.Column="2" Content="تغییر نام" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </StackPanel>
</Window>
